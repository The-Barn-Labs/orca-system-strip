{
  "manifestVersion": 2,
  "id": "system-strip",
  "name": "System Strip",
  "version": "0.1.0",
  "description": "CPU, GPU, memory, battery and a clock in Orca's bottom status bar.",
  "license": "MIT",
  "repository": "https://github.com/The-Barn-Labs/orca-system-strip",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "statusBarItems": [
      { "id": "cpu", "text": "CPU –", "icon": "activity", "tooltip": "System Strip", "command": "system-strip.openActivityMonitor" },
      { "id": "gpu", "text": "GPU –", "icon": "gauge", "tooltip": "System Strip", "command": "system-strip.openActivityMonitor" },
      { "id": "memory", "text": "Mem –", "icon": "layers", "tooltip": "System Strip", "command": "system-strip.openActivityMonitor" },
      { "id": "battery", "text": "Bat –", "tooltip": "System Strip" },
      { "id": "clock", "text": "--:--", "tooltip": "System Strip" }
    ],
    "commands": [
      { "id": "system-strip.openActivityMonitor", "title": "System Strip: Open Activity Monitor", "when": "global" }
    ],
    "settings": [
      { "key": "showCpu", "title": "Show CPU", "type": "boolean", "default": true },
      { "key": "showGpu", "title": "Show GPU", "type": "boolean", "default": true },
      { "key": "showMemory", "title": "Show memory", "type": "boolean", "default": true },
      { "key": "showBattery", "title": "Show battery", "description": "Hidden anyway on a Mac without a battery.", "type": "boolean", "default": true },
      { "key": "showClock", "title": "Show clock", "type": "boolean", "default": true },
      { "key": "clock24h", "title": "24-hour clock", "description": "Off shows a 12-hour clock with AM/PM.", "type": "boolean", "default": true },
      { "key": "refreshSeconds", "title": "Refresh every", "description": "How often CPU and memory update. The GPU updates no faster than every 4 seconds.", "type": "integer", "enum": [1, 2, 5], "enumLabels": ["1 second", "2 seconds", "5 seconds"], "default": 2 }
    ]
  },
  "capabilities": [
    { "kind": "settings:own" }
  ]
}
